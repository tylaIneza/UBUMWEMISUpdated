# Copy to .env and fill in. Never commit .env. Use a separate file / secret store per environment.

# development | staging | production
NODE_ENV=development
PORT=4000

# MariaDB 10.4+ / MySQL 8. Use a dedicated database user with rights on this database only.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/rpms
# Separate database used ONLY by automated tests. Its name must end in _test; tests wipe it.
TEST_DATABASE_URL=mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/rpms_test

# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME
SESSION_TTL_HOURS=12

# Public address of the web app (used in password-reset and verification links).
APP_URL=http://localhost:5173

# Private directory for uploaded documents. Must NOT be inside a web-served folder. Back it up.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Production: directory of the built web app that the API server should serve (web/dist).
WEB_DIST=
# Number of reverse proxies in front of the server (1 behind nginx / a load balancer), for correct client IPs.
TRUST_PROXY=0
LOG_LEVEL=info

# Optional e-mail. Leave empty to disable: the app then never claims an e-mail was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS for tenant reminders. Leave empty to disable: the app then never claims an SMS was sent.
#   Africa's Talking:  SMS_PROVIDER=africastalking  SMS_USERNAME=<app username>  SMS_API_KEY=<API key>
#   Pindo:             SMS_PROVIDER=pindo           SMS_API_KEY=<API token>
# SMS_SENDER_ID is the sender name approved by the provider (e.g. UBUMWEHOUSE); leave empty for the provider default.
SMS_PROVIDER=
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=

# First-run bootstrap only (npm run bootstrap -w server). Remove afterwards.
ORG_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
